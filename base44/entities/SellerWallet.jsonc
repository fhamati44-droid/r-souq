{
  "name": "SellerWallet",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "total_deposited": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "owner_email",
    "balance"
  ]
}