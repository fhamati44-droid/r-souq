{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "object",
      "description": "Product name in multiple languages",
      "properties": {
        "ar": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      }
    },
    "description": {
      "type": "object",
      "properties": {
        "ar": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      }
    },
    "price": {
      "type": "number"
    },
    "original_price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "clothing",
        "electronics",
        "home",
        "sports",
        "beauty",
        "books",
        "toys",
        "food"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_new": {
      "type": "boolean",
      "default": false
    },
    "is_on_sale": {
      "type": "boolean",
      "default": false
    },
    "brand": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "price"
  ]
}