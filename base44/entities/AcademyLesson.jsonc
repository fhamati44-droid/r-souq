{
  "name": "AcademyLesson",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "lesson_content": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_preview": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "module_id",
    "title"
  ]
}