{
  "name": "Lead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "interest_type": {
      "type": "string",
      "enum": [
        "new_investor",
        "existing_merchant",
        "supplier"
      ]
    },
    "has_experience": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    },
    "experience_details": {
      "type": "string"
    },
    "management_preference": {
      "type": "string",
      "enum": [
        "self",
        "team"
      ]
    },
    "investment_goal": {
      "type": "string",
      "enum": [
        "additional_income",
        "main_project",
        "expand"
      ]
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "50k",
        "100k",
        "100k_160k"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "converted",
        "lost"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "phone",
    "interest_type"
  ]
}